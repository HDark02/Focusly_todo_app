<Ajouter_taches_screen@MDScreen>:
    name: "ajouter_tache_name"
    task_input:task_input
	date_date:date_date
	time_time:time_time
	note_task:note_task
    info_error:info_error
    MDFloatLayout:
        md_bg_color: "#040A14"
        orientation: 'vertical'
        MDCard:
            md_bg_color: "#040A14"
            size_hint: .9, .2
            radius: [20, ]
            pos_hint: {"center_x": .5, "top": 1}
            MDFloatLayout:
                pos_hint: {"center_x": .5, "center_y": .5}
                MDLabel:
                    text: "Focusly"
                    theme_text_color: "Custom"
                    text_color: "#3d86e6"
                    pos_hint: {"x": .05, "center_y": .75}
                    font_size: "20sp"
                    bold: True
                MDLabel:
                    text: "Ajouter une nouvelle tâches"
                    theme_text_color: "Custom"
                    text_color: "white"
                    pos_hint: {"x": .05, "center_y": .2}
                    font_size: "20sp"
                    bold: True
                MDIcon:
                    icon: "app_icon.png"
                    pos_hint: {"center_x": .9, "center_y": .5}
                    theme_text_color: "Custom"
                    text_color: "black"
                    font_size: "100sp"
                    # opacity: root.icon_bord_opacity

        MDFloatLayout:
            pos_hint: {"center_x": .5, "top": .8}
            md_bg_color: "#e1ececdc"

            MDFloatLayout:
                size_hint_y: .15
                # height: "400dp"
                orientation: "vertical"
                pos_hint: {"top": .95, "center_x": .5}
                MDLabel:
                    text: "Nom de la tâche"
                    font_size: "20sp"
                    theme_text_color: "Custom"
                    text_color: "black"
                    halign: "left"
                    pos_hint: {"x": .07, "center_y": .85}
                Input_cart:
                    id: task_input
                    hint_text: "Prototype"
                    pos_y: .4
                
            MDFloatLayout:
                size_hint_y: .15
                # height: "400dp"
                orientation: "vertical"
                pos_hint: {"top": .77, "center_x": .5}
                radius: [20, 20, 0, 0]
                MDLabel:
                    text: "Choisir la Date et l'heure"
                    font_size: "20sp"
                    theme_text_color: "Custom"
                    text_color: "black"
                    halign: "left"
                    pos_hint: {"x": .07, "center_y": .85}
                Input_cart:
                    id: date_date
                    hint_text: "DD/MM/YYYY"
                    pos_y: .4
                    halign: "center"
                    # on_focus: app.show_date_picker()
                    size_hint: .4, .6
                    pos_hint: {"center_x": .25, "center_y": .4}
                    
                    
                MDIconButton:
                    icon: "calendar"
                    icon_size: "15sp"
                    pos_hint: {"x": .05, "center_y": .45}
                    theme_text_color:  "Custom"
                    text_color: "blue"
                Input_cart:
                    id: time_time
                    hint_text: "HH:MM"
                    pos_y: .4
                    halign: "center"
                    # on_focus: app.show_time_picker()
                    size_hint: .4, .6
                    pos_hint: {"center_x": .75, "center_y": .4}

                MDIconButton:
                    icon: "clock-alert"
                    theme_text_color: "Custom"
                    icon_color:  "blue"
                    icon_size: "15sp"
                    pos_hint: {"x": .55, "center_y": .45}
            MDFloatLayout:
                size_hint_y: .25
                # height: "400dp"
                orientation: "vertical"
                pos_hint: {"top": .6, "center_x": .5}
                radius: [20, 20, 0, 0]
                MDLabel:
                    text: "Note"
                    font_size: "20sp"
                    theme_text_color: "Custom"
                    text_color: "black"
                    halign: "left"
                    pos_hint: {"x": .07, "center_y": .85}
                Input_cart:
                    id: note_task
                    hint_text: "Mobile Application"
                    pos_y: .4
                    size_hint: .9, .6
                    pos_hint: {"center_x": .5, "center_y": .4}
            MDLabel:
                id: info_error
                text: "Choisir la Date et l'heure"
                font_size: "15sp"
                theme_text_color: "Custom"
                text_color: "red"
                halign: "center"
                opacity: 0
                pos_hint: {"center_x": .5, "center_y": .6}
            MDFillRoundFlatButton:
                text: "Ajouter"
                theme_text_color: "Custom"
                md_bg_color: "blue"
                font_size: "18sp"
                halign: "center"
                size_hint: .8, .07
                pos_hint: {"center_x": .5, "center_y": .25}
                on_release: 
                    # app.printable_data()
                    app.ad_todo(task_input.text, date_date.text, time_time.text, note_task.text)
        ######################################################

                MDProgressBar:
                    size_hint: 1, .001
                    value: 100
                    pos_hint: {"center_x":.5, "center_y": 0}
                    theme_text_color: "Custom"
                    color: "white"
                MDFloatLayout:
                    size_hint: 1, .1
                    pos_hint: {"center_x":.5, "center_y": .05}
##################################################################################################################"
<Tableau_de_bord@MDScreen>:
    date_actuelle: date_actuelle
    name: "tableau_de_bord"
    todo_list:todo_list
    MDFloatLayout:
        md_bg_color: "#040A14"
        orientation: 'vertical'
        MDCard:
            md_bg_color: "#040A14"
            size_hint: .9, .2
            radius: [20, ]
            pos_hint: {"center_x": .5, "top": 1}
            MDFloatLayout:
                pos_hint: {"center_x": .5, "center_y": .5}
                MDLabel:
                    text: "Focusly"
                    theme_text_color: "Custom"
                    text_color: "#3d86e6"
                    pos_hint: {"x": .05, "center_y": .75}
                    font_size: "20sp"
                    bold: True
                MDLabel:
                    text: "Tableau de bord"
                    theme_text_color: "Custom"
                    text_color: "white"
                    pos_hint: {"x": .05, "center_y": .5}
                    font_size: "20sp"
                    bold: True
                MDLabel:
                    id: date_actuelle
                    text: "Aperçu de l'activité du 15/02/2026"
                    theme_text_color: "Custom"
                    text_color: "white"
                    pos_hint: {"x": .05, "center_y": .24}
                    font_size: "15sp"
                    opacity: 0.8
                MDIcon:
                    icon: "app_icon.png"
                    pos_hint: {"center_x": .9, "center_y": .5}
                    theme_text_color: "Custom"
                    text_color: "black"
                    font_size: "100sp"
                    # opacity: root.icon_bord_opacity
        MDLabel:
            text: "Mes Tâches"
            theme_text_color: "Custom"
            text_color: "white"
            pos_hint: {"x": .1, "center_y": .8}
            font_size: "25sp"
            opacity: 0.8
            bold: True
        ScrollView:
            pos_hint: {"center_x":.5, "top": .75}
            do_scroll: False, True
            size_hint: .9, 0.75
            MDGridLayout:
                id: todo_list
                cols: 1
                # rows: 3
                pos_hint: {"center_x":.5, "top": .7}
                size_hint_x: .9
                size_hint_y: 0
                spacing: 15
                # md_bg_color: "red"
################################################################################################################"
    
MDScreen:
    navig: navig
    name: "gestion_des_vente_home"
    MDFloatLayout:
        md_bg_color: "white"
        MDBottomNavigation:
            id: navig
            pos_hint: {"center_x": .5, "y": 0}
            panel_color:   "#040A14"
            theme_text_color: "Custom"
            text_color_active: "#1465f1"
            on_text_color_normal: "red"
            # selected_color_background: "orange"
            text_color_normal: "gray"
            line_color: "white"
            acceuil_id : acceuil_id
            ajout_id : ajout_id
            termine_id : termine_id
            MDBottomNavigationItem:
                id: acceuil_id
                name: "tableau_de_bord"
                text: "Acceuil"
                icon: "chart-pie"
                tableau_de_bord_id:tableau_de_bord_id
                Tableau_de_bord:
                    id: tableau_de_bord_id
            MDBottomNavigationItem:
                id: ajout_id
                name: "ajouter_taches_screen"
                text: "Ajouter"
                icon:  "plus"
                ajouter_taches_screen_id : ajouter_taches_screen_id
                Ajouter_taches_screen:
                    id: ajouter_taches_screen_id

            MDBottomNavigationItem:
                id: termine_id
                name: "termine"
                text: "Tâches Terminées"
                icon: "file-document-outline"
                tache_termine_id:tache_termine_id
                Tache_termine_screen:
                    id: tache_termine_id
            # MDBottomNavigationItem:
            #     id: profile_id
            #     name: "profile"
            #     text: "Profil"
            #     icon: "cog-outline"
            #     MDScreen:
            #         name: "screen 4"
            #         MDFloatLayout:
            #             id: data
            #             pos_hint: {"center_x": .5, "center_y": .5}
                